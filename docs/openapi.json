  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_input": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "User Input"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "client_request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Request Id"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_input"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "message_id": {
            "type": "integer",
            "title": "Message Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "intent": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Steps"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          },
          "rounds": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rounds"
          },
          "evidence_sufficient": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Sufficient"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "run_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run State"
          },
          "error_info": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Info"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          },
          "queue_wait_ms": {
            "type": "integer",
            "title": "Queue Wait Ms",
            "default": 0
          },
          "plan_version": {
            "type": "integer",
            "title": "Plan Version",
            "default": 0
          },
          "checkpoint_generation": {
            "type": "integer",
            "title": "Checkpoint Generation",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "message_id",
          "trace_id",
          "success",
          "answer",
          "intent",
          "steps",
          "latency_ms",
          "error"
        ],
        "title": "ChatResponse"
      },
      "ConversationCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "default": "新会话"
          }
        },
        "type": "object",
        "title": "ConversationCreate"
      },
      "GraphRequest": {
        "properties": {
          "user_input": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "User Input"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "client_request_id": {
            "anyOf": [
