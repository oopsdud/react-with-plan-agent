          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "api_key_configured": {
            "type": "boolean",
            "title": "Api Key Configured"
          },
          "json_mode": {
            "type": "boolean",
            "title": "Json Mode"
          }
        },
        "type": "object",
        "required": [
          "base_url",
          "model",
