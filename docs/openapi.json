{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent System",
    "description": "ReAct-with-Plan 智能体框架",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "description": "根路径",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/runtime": {
      "get": {
        "tags": [
          "Runtime"
        ],
        "summary": "Runtime Info",
        "description": "返回不含密钥的运行配置；工具目前均为 Mock。",
        "operationId": "runtime_info_runtime_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "description": "聊天接口（完整Agent流程）",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/intent": {
      "post": {
        "summary": "Recognize",
        "description": "意图识别接口（仅识别，不执行）",
        "operationId": "recognize_intent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "get": {
        "summary": "List Tools",
        "description": "列出可用工具",
        "operationId": "list_tools_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tools/{tool_name}": {
      "get": {
        "summary": "Get Tool Info",
        "description": "获取工具信息",
        "operationId": "get_tool_info_tools__tool_name__get",
        "parameters": [
          {
            "name": "tool_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tool Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolInfoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_input": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "User Input",
            "description": "用户输入"
          },
          "user_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "User Id",
            "description": "用户ID",
            "default": "default_user"
          },
          "session_history": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Session History",
            "description": "会话历史"
          }
        },
        "type": "object",
        "required": [
          "user_input"
        ],
        "title": "ChatRequest",
        "description": "聊天请求"
      },
      "ChatResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "intent": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Steps"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "success",
          "answer",
          "intent",
          "steps",
          "latency_ms",
          "error"
        ],
        "title": "ChatResponse",
        "description": "聊天响应"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntentRequest": {
        "properties": {
          "user_input": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "User Input"
          },
          "session_history": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Session History"
          }
        },
        "type": "object",
        "required": [
          "user_input"
        ],
        "title": "IntentRequest",
        "description": "意图识别请求"
      },
      "IntentResponse": {
        "properties": {
          "intent_id": {
            "type": "string",
            "title": "Intent Id"
          },
          "complexity": {
            "type": "string",
            "title": "Complexity"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "is_multi_intent": {
            "type": "boolean",
            "title": "Is Multi Intent"
          },
          "secondary_intents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Secondary Intents"
          },
          "extracted_slots": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extracted Slots"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning"
          },
          "routing_path": {
            "type": "string",
            "title": "Routing Path"
          }
        },
        "type": "object",
        "required": [
          "intent_id",
          "complexity",
          "confidence",
          "is_multi_intent",
          "secondary_intents",
          "extracted_slots",
          "reasoning",
          "routing_path"
        ],
        "title": "IntentResponse",
        "description": "意图识别响应"
      },
      "RuntimeResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "llm_mode": {
            "type": "string",
            "title": "Llm Mode"
          },
          "llm_model": {
            "type": "string",
            "title": "Llm Model"
          },
          "embedding_provider": {
            "type": "string",
            "title": "Embedding Provider"
          },
          "embedding_note": {
            "type": "string",
            "title": "Embedding Note"
          },
          "tools_mode": {
            "type": "string",
            "title": "Tools Mode"
          },
          "streaming": {
            "type": "boolean",
            "title": "Streaming"
          }
        },
        "type": "object",
        "required": [
          "version",
          "llm_mode",
          "llm_model",
          "embedding_provider",
          "embedding_note",
          "tools_mode",
          "streaming"
        ],
        "title": "RuntimeResponse"
      },
      "ToolInfoResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Timeout Seconds"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "timeout_seconds"
        ],
        "title": "ToolInfoResponse"
      },
      "ToolListResponse": {
        "properties": {
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "tools",
          "count"
        ],
        "title": "ToolListResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
