        ],
        "title": "ModelList"
      },
      "ModelSave": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Base Url"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "model": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Model"
          },
          "json_mode": {
            "type": "boolean",
            "title": "Json Mode",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "base_url",
          "model"
        ],
        "title": "ModelSave"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
