# Server-side credentials only. Replace placeholders and restart backend.
APP_NAME=react-with-plan-agent
DEBUG=false
DATABASE_URL=sqlite:///./data/agent.db
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]

# Model settings can be saved in the UI instead; data/model-config.json takes precedence.
# OpenAI-compatible Chat Completions endpoint (usually ends in /v1).
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=YOUR_MODEL_NAME
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=60

# Keyless public-engine search. Optional self-hosted SearXNG backend.
SEARCH_PROVIDER=ddgs
DDGS_BACKEND=auto
DDGS_REGION=us-en
SEARCH_SAFESEARCH=moderate
# DDGS_PROXY=http://127.0.0.1:7890
# SEARXNG_BASE_URL=http://127.0.0.1:8088
SEARCH_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=30
MAX_STEP_RETRIES=2

# Legacy episodic-memory modules are excluded from chat to isolate conversations.
EPISODIC_MEMORY_ENABLED=false
CHROMA_PERSIST_DIR=./data/chroma

# Seeded only when the account does not exist; changing this does not reset passwords.
DEFAULT_USER1_PASSWORD=AgentUser1!
DEFAULT_USER2_PASSWORD=AgentUser2!
DEFAULT_USER3_PASSWORD=AgentUser3!
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
