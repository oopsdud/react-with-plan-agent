# Local development. Copy this file to .env; never commit actual secrets.
APP_NAME=react-with-plan-agent
DEBUG=false
DATABASE_URL=sqlite:///./data/agent.db
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Explicit mock mode works without API keys or downloading local models.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=https://your-provider.example/v1

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://your-provider.example/v1

MAX_STEP_RETRIES=3
TOOL_TIMEOUT_SECONDS=30

# These fields are reserved; automatic TTL/size maintenance is not implemented.
EPISODIC_MEMORY_TTL_DAYS=7
EPISODIC_MEMORY_PER_INTENT_LIMIT=20
