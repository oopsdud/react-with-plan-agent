# Server-side credentials only. Replace placeholders and restart backend.
APP_NAME=react-with-plan-agent
DEBUG=false
DATABASE_URL=sqlite:///./data/agent.db
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]

# Model settings can be saved in the UI instead; data/model-config.json takes precedence.
# OpenAI-compatible Chat Completions endpoint (usually ends in /v1).
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=YOUR_MODEL_NAME
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=60

# Keyless public-engine search. Optional self-hosted SearXNG backend.
SEARCH_PROVIDER=ddgs
DDGS_BACKEND=auto
DDGS_REGION=us-en
SEARCH_SAFESEARCH=moderate
# DDGS_PROXY=http://127.0.0.1:7890
# SEARXNG_BASE_URL=http://127.0.0.1:8088
SEARCH_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=30
MAX_STEP_RETRIES=2

# Legacy episodic-memory modules are excluded from chat to isolate conversations.
EPISODIC_MEMORY_ENABLED=false
CHROMA_PERSIST_DIR=./data/chroma

# Seeded only when the account does not exist; changing this does not reset passwords.
DEFAULT_USER1_PASSWORD=AgentUser1!
DEFAULT_USER2_PASSWORD=AgentUser2!
DEFAULT_USER3_PASSWORD=AgentUser3!
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# Bounded single-process scheduling; restart to apply. These are capacity caps, not throughput claims.
HTTP_MAX_CONCURRENT=128
AGENT_MAX_CONCURRENT=4
AGENT_MAX_QUEUED=32
USER_MAX_CONCURRENT=1
USER_MAX_QUEUED=3
USER_REQUESTS_PER_MINUTE=20
AGENT_QUEUE_TIMEOUT_SECONDS=60
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_SHUTDOWN_GRACE_SECONDS=15
LLM_MAX_CONCURRENT=4
SEARCH_MAX_CONCURRENT=4
DEPENDENCY_SLOT_TIMEOUT_SECONDS=2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_SECONDS=30
STREAM_BUFFER_EVENTS=128
MODEL_CATALOG_STALE_SECONDS=600
AUTH_LOGIN_PER_IP_PER_MINUTE=60
AUTH_LOGIN_PER_ACCOUNT_PER_MINUTE=10

CONTEXT_MAX_CHARS=48000
LLM_MAX_RESPONSE_CHARS=60000
